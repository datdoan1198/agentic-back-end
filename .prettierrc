{
  "printWidth": 110,
  "semi": false,
  "singleQuote": true,
  "bracketSpacing": false,
  "overrides": [
    {
      "files": "*.js",
      "options": {
        "semi": false,
        "singleQuote": true,
        "trailingComma": "es5",
        "tabWidth": 4,
        "printWidth": 120,
        "bracketSpacing": true,
        "arrowParens": "always",
        "endOfLine": "lf"
      }
    }
  ]
}
